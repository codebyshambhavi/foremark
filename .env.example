# =============================================================================
# FOREMARK environment configuration (TEMPLATE - variable names and placeholders only)
#
#   cp .env.example .env        then edit .env locally
#
# .env is git-ignored. NEVER commit real secrets, and never paste them into
# chat tools, issues or source code. Backend-only values must never be exposed
# to the frontend (the frontend only receives NEXT_PUBLIC_* values, which are
# public by design).
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Local development defaults match docker-compose.yml. These are throwaway
# local credentials, not production ones. Driver: psycopg 3.
POSTGRES_USER=foremark
POSTGRES_PASSWORD=foremark_dev_only
POSTGRES_DB=foremark
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://foremark:foremark_dev_only@localhost:5432/foremark
# Separate database used only by the automated test suite (created by docker-compose init script).
TEST_DATABASE_URL=postgresql+psycopg://foremark:foremark_dev_only@localhost:5432/foremark_test

# --- Application security (backend) -----------------------------------------
# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated list of allowed browser origins for the API (CORS).
CORS_ORIGINS=http://localhost:3000

# --- Gnani Prisma speech-to-text (backend only) ------------------------------
# API key ID from the Gnani dashboard. Sent in the X-API-Key-ID header.
GNANI_API_KEY_ID=replace-with-your-gnani-api-key-id
# Endpoint and model per Gnani's documentation (docs.gnani.ai). Override only if the docs change.
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
# prisma-v3.0 accepts "indic-auto" or up to 4 comma-separated codes, e.g. hi-IN,en-IN
GNANI_STT_LANGUAGE=indic-auto
# Per-request timeout in seconds (Gnani returns 504 if its own processing exceeds 5 s).
GNANI_TIMEOUT_SECONDS=30
# Retries apply only to 429 / 5xx / network errors, never to 400/401/402/403.
GNANI_MAX_RETRIES=3
# Gnani REST accepts at most 30 s of audio per request; chunks are kept safely below that.
GNANI_CHUNK_SECONDS=25

# --- Gnani Timbre text-to-speech (optional, lower priority) ------------------
# Uses the same GNANI_API_KEY_ID. Leave disabled until the core workflow is complete.
TIMBRE_ENABLED=false
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# --- File storage (photos, audio, evidence) ----------------------------------
# local = files under LOCAL_STORAGE_PATH (development).  s3 = any S3-compatible bucket (production).
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_MB=25
# Only needed when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Frontend (copy to frontend/.env.local; public values only) --------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
